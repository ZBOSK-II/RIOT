config CPU_ARCH_RISCV
    bool

config CPU_CORE_RV32IMAC
    bool
    select CPU_ARCH_RISCV

config CPU_CORE_RV64IMAC
    bool
    select CPU_ARCH_RISCV

config CPU_CORE
    default "rv32imac" if CPU_CORE_RV32IMAC
    default "rv64imac" if CPU_CORE_RV64IMAC

config CPU_ARCH
    default "rv32" if CPU_CORE_RV32IMAC
    default "rv64" if CPU_CORE_RV64IMAC



